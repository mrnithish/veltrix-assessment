# Copy to .env and fill in ONE provider key. Never commit .env.
# Paths are relative to the app's working directory; docker-compose mounts ./data at ./data.

# --- data (required by the task) ---
CORPUS_DIR=./data/corpus
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/veltrix.db
# Today's date as YYYY-MM-DD. Empty = system date.
APP_TODAY=
# Timezone for 'today' and the current time (IANA name, e.g. Asia/Kolkata). Containers run in UTC otherwise.
APP_TIMEZONE=UTC

# --- LLM ---
# auto | nvidia | openai | anthropic | gemini | ollama   (auto = whichever key below is set)
# Can also be switched at runtime from the UI or POST /llm.
LLM_PROVIDER=auto
# Empty = provider default (nvidia: nvidia/nemotron-3.5-lightning-30b-a3b, openai: gpt-4.1-mini,
# anthropic: claude-sonnet-5-5, gemini: gemini-2.5-flash, ollama: gpt-oss:120b)
LLM_MODEL=
LLM_TIMEOUT_S=20
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
# Optional JSON merged into OpenAI-compatible requests, e.g. {"reasoning_effort": "low"}
LLM_EXTRA_BODY=
# Comma-separated models tried when the primary fails; the next one also starts in parallel after
# LLM_HEDGE_AFTER_S seconds if the current one is slow. Empty = provider defaults.
LLM_FALLBACK_MODELS=
LLM_HEDGE_AFTER_S=4

# --- agent ---
# codemode (LLM writes a sandboxed Python program) | tools (classic function calling)
AGENT_MODE=codemode

# --- retrieval ---
QDRANT_URL=http://qdrant:6333
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- app state, observability, UI ---
STATE_DB_PATH=./state/app_state.db
# Set to http://phoenix:6006 when running with --profile full to export traces
OTEL_EXPORTER_OTLP_ENDPOINT=
PHOENIX_UI_URL=http://localhost:6006
LOG_LEVEL=INFO
DEV_ENDPOINTS=true
# Web UI demo login (every employee shares this password) and the token signing secret
DEMO_PASSWORD=veltrix
APP_SECRET=
CORS_ORIGINS=http://localhost:3000
# Extra host[:port] values allowed to call the MCP endpoint (/mcp/), comma-separated
MCP_ALLOWED_HOSTS=
NEXT_PUBLIC_API_URL=http://localhost:8000
